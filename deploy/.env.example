# ================================================================
# 复制为 .env 后按需填写。podman-compose 会自动读取同目录的 .env。
#   cp .env.example .env
# ================================================================

# 中文镜像名（默认即为构建脚本产出的名字，一般不用改）
CN_IMAGE=localhost/erpnext-cn:v15.32.0
BASE_IMAGE=docker.io/frappe/erpnext:v15.32.0

# ----------------------------------------------------------------
# MCP（AI 助手）连接 ERPNext 用的凭据
# 生成方式：登录 ERPNext -> 右上角头像 -> Settings -> API Access -> Generate Keys
# ⚠️ 不要用 Administrator 账号。建议新建专用用户，只给必要的读权限。
# ----------------------------------------------------------------
MCP_ERP_API_KEY=
MCP_ERP_API_SECRET=

# ----------------------------------------------------------------
# MCP 相关参数
#   MCP_NPM_PACKAGE : npm 包名。必须是带作用域的 @casys/mcp-erpnext，
#                     裸名 mcp-erpnext 在 npm 上不存在，会导致容器秒退。
#   MCP_PORT        : MCP 以 HTTP 模式监听的端口（stdio 模式不能做常驻服务）。
#                     容器内监听该端口，对宿主只绑 127.0.0.1。
# ----------------------------------------------------------------
MCP_NPM_PACKAGE=@casys/mcp-erpnext
MCP_PORT=3012
